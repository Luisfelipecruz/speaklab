# SpeakLab — copy to .env and edit nothing. Every value here is the default already, in
# docker-compose.yml or api/config.py, so a fresh clone needs no edits: `make setup`
# copies this file to .env if there is none.
#
# Every key reaches the API — docker-compose.yml gives it the whole file through
# `env_file` — and the rest reach the container that names them. A changed value takes
# effect when that container is recreated: `make restart` for the API, `make up` for
# the others.
#
# Host ports are fixed in docker-compose.yml, offset from the usual defaults so the stack
# can run beside others: frontend 3003, api 8002, postgres 5433, asr 8101, tts 8102,
# pron 8103. See speaklab-agent/IMPLEMENTATION-PLAN.md §2.1.

# ── Database ────────────────────────────────────────────────────────────────
DB_USER=speaklab
DB_PASSWORD=speaklab_dev
DB_NAME=speaklab

# SQL_ECHO=1 logs every statement SQLAlchemy emits. Useful for proving a query count
# rather than asserting one.
SQL_ECHO=0

# ── Model services ──────────────────────────────────────────────────────────
#
# Three services, none of them inside the API image (I5). The API has NO depends_on for
# any of them: it must start and serve scenarios, sessions and progress while the models
# are still loading, and on a machine that never starts them at all (FR-27).
#
# asr   m4  faster-whisper on CTranslate2 — no torch. 746 MB measured, not the ~400 MB
#           m4 was planned around; the weight is CTranslate2 plus ONNX Runtime (Silero
#           VAD's runtime). openai-whisper would be ~2.5 GB, which was the actual point.
# tts   m5  Piper on onnxruntime — no torch either. The voice is 63 MB and is baked into
#           the image at build time, so there is no first-request download and no cold
#           first turn. The image is 672 MB, nearly all of it onnxruntime and the base.
# pron  m8  wav2vec2 + torch, ~2 GB. Profiled separately for that reason.
#
# As of m5 neither asr nor tts is profiled: both are part of the default stack, and the
# `speech` profile that used to hold them is gone. `make up` builds them and downloads
# the Whisper weights on a first run. The API still has no depends_on for either.
ASR_URL=http://asr:8101
TTS_URL=http://tts:8102
PRON_URL=http://pron:8103

# How long /health waits on each model service before calling it unreachable. The three
# probes run concurrently, so this is the ceiling for all three, not per service. It is
# deliberately short: /health is what the container health check calls, and a liveness
# probe that can hang is worse than no probe.
HEALTH_PROBE_TIMEOUT_S=1.5

PRON_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft

# ── Audio and ASR (m4) ──────────────────────────────────────────────────────
#
# small.en at beam 5 measures 1.72% WER on the golden set and 1231 ms on ~6 s of audio,
# against a 700 ms budget it therefore MISSES. base.en at beam 1 meets the budget at
# 525 ms and costs 4.31% WER. The full measurement and the reason the default did not
# change is docs/decisions/0001-asr-model-choice.md; the switch is one line:
#   WHISPER_MODEL=base.en
#   WHISPER_BEAM_SIZE=1
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

# Silero VAD. On by default because Whisper hallucinates on silence — it writes
# "Thank you." for an empty recording, and a learner who hesitated would be scored on
# words they never said. Measured: turning it off doubled WER *and* was slower.
WHISPER_VAD=1

# 0 lets CTranslate2 choose, which is right on a machine this file cannot know the size
# of. Set it when the container shares a host with something latency-sensitive.
WHISPER_CPU_THREADS=0

# Where recordings live: a named volume, never a bind mount and never a path inside the
# repository. A recording that can appear in `git status` is one that can reach history.
AUDIO_ROOT=/audio

# 10 MB, roughly five minutes of 16 kHz mono WAV and far more of anything a browser
# sends. The asr service enforces a higher ceiling of its own — the API's limit is a
# product decision, the service's is a bound on damage.
MAX_UPLOAD_BYTES=10485760

# Long on purpose, and not HEALTH_PROBE_TIMEOUT_S. A cold asr container is loading
# weights and the first transcription after a restart waits for that; failing early
# would turn a slow start into a lost recording.
ASR_TIMEOUT_S=120

# ── Speech synthesis (m5) ───────────────────────────────────────────────────
#
# The voice. It is used twice: as a build argument, deciding which voice is baked into
# the tts image, and as a runtime variable, deciding which the process loads. Change it
# and `make up` rebuilds with the new one; leave the rebuild out and the container
# downloads it into the shared volume on first start instead, which costs a minute once.
PIPER_VOICE=en_US-lessac-medium

# 8, and it is measured, not chosen. onnxruntime's own default is 2.3x slower on this
# machine — 831 ms against 368 ms for an 80-token reply, which is the difference between
# missing PRD §9.1's 400 ms budget and meeting it. The curve is a U with its minimum at
# 8 on 16 cores: 1 thread is 1248 ms and 16 is 925 ms, so more is emphatically not
# better. Set 0 to hand the choice back to onnxruntime. See
# docs/decisions/0002-tts-model-choice.md for the sweep.
PIPER_NUM_THREADS=8

# Phoneme length scale: below 1 is faster speech, above 1 is slower. 1.0 is the rate the
# voice was trained at. A slower interlocutor is a real setting for a beginner band.
PIPER_LENGTH_SCALE=1.0

# Short, and deliberately not ASR_TIMEOUT_S. The recogniser's 120 s covers a cold
# container downloading 746 MB; the tts image already contains its voice, so there is no
# cold start to be generous about and 30 s means a stuck process is reported as one.
TTS_TIMEOUT_S=30

# ── Auth (m3) ───────────────────────────────────────────────────────────────
#
# JWT_SECRET is the one key here with no safe default. Left unset, the API signs
# sessions with a fixed development key that is written down in api/config.py — anyone
# holding this repository can mint a valid session cookie — and it says so in the
# startup log every time. That is the right trade for a laptop and wrong everywhere
# else. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Fixed rather than random-per-process on purpose: a random default would invalidate
# every cookie on restart, and under more than one worker each worker would sign with a
# different key, so a user would be logged out on most of their requests with nothing in
# the logs to explain it.
# JWT_SECRET=

# How long a session lasts. There is no refresh token and no revocation list, so this is
# also how long a stolen cookie stays useful. Seven days.
ACCESS_TOKEN_TTL_HOURS=168

# Set to 1 wherever there is TLS. Left at 0 for the laptop stack, which is http:// —
# a Secure cookie there is set by the API, dropped by the browser, and the only symptom
# is a login that appears to work followed by a /auth/me that 401s.
COOKIE_SECURE=0

# `lax` covers localhost:3003 -> localhost:8002 (SameSite ignores the port, so those are
# the same site) and app.example.com -> api.example.com. Genuinely different domains
# need `none`, which also requires COOKIE_SECURE=1.
COOKIE_SAMESITE=lax

# Where the browser may call the API from. Comma-separated. Change it together with the
# address you open the app at — a request from anywhere else is refused by the browser.
CORS_ORIGINS=http://localhost:3003

# ── Frontend ────────────────────────────────────────────────────────────────
#
# Two URLs because there are two callers. The browser resolves localhost:8002 from the
# host; a server component resolves api:8000 inside the compose network. Using one for
# both is the classic Next.js container bug.
NEXT_PUBLIC_API_URL=http://localhost:8002
INTERNAL_API_URL=http://api:8000

# ── Generation (m6) ─────────────────────────────────────────────────────────
#
# host.docker.internal, deliberately. Docker Desktop on macOS cannot pass the Apple GPU
# into a Linux container, so `docker compose --profile llm up ollama` runs the same model
# on CPU — several times slower for no benefit. The host's Ollama uses Metal. Switch to
# http://ollama:11434 on a Linux host with a GPU, or in CI.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Pull it before the first conversation: `ollama pull gemma3:4b`, about 3.3 GB. Without
# it every conversation fails, and `make llm-check` says so and names the command. Whether
# 4b is strong enough for constrained-JSON error labelling is open question Q4, answered
# at m9 by the out-of-taxonomy rejection rate — not by preference.
OLLAMA_MODEL=gemma3:4b

# Ceilings, not targets. A prompt-assembly bug shows up here as a refused request
# rather than as a five-minute turn.
LLM_TIMEOUT_S=120
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=400

# How long Ollama keeps the weights resident between turns. Its own default is five
# minutes, so a user who stops to think for six pays the ~2.6 s model load again on
# their next turn. Host RAM, which the PRD's 8 GB stack ceiling explicitly excludes.
OLLAMA_KEEP_ALIVE=10m

# The context window, and the one setting here that is not a preference. **Ollama does
# not refuse a prompt that does not fit** — llama.cpp shifts the context, discards half
# of it, and answers 200 anyway with nothing in the response to say so. Measured:
# 4200 tokens under num_ctx 4096 came back with prompt_eval_count 2051. Unset, this is
# derived as LLM_MAX_INPUT_TOKENS x LLM_ESTIMATOR_MARGIN + LLM_MAX_OUTPUT_TOKENS.
# Only set it by hand if you are short of host RAM and know what you are giving up.
# LLM_NUM_CTX=5400

# Characters per token, used to size a prompt before sending it — there is no Gemma
# tokenizer in the API image and there will not be one (it means torch; invariant I5).
# The margin is how wrong it is allowed to be: measured error ranged from -8.9 % to
# +5.7 % on realistic prompts, and 1.25 is what the context window above is sized from.
LLM_CHARS_PER_TOKEN=4.0
LLM_ESTIMATOR_MARGIN=1.25

# Running summary of the turns that no longer fit, and when to write it. FR-8: turns
# that fall out of the window are summarised, not dropped. The high-water mark is below
# 1.0 so that the fold happens while everything still fits, which is what lets it run
# after the reply has been sent rather than while somebody waits for it.
LLM_DIGEST_MAX_TOKENS=200
LLM_HISTORY_HIGH_WATER=0.7

# PRD §9.1's first prescribed fallback: hand each finished sentence to the voice while
# the model is still writing the next one. Set to 0 to run them in series — which is the
# control arm for `make turn-latency-noflow`, and not something to run in anger.
LLM_STREAM_TO_TTS=1

# ── Sessions (m6) ───────────────────────────────────────────────────────────
#
# `GET /sessions` is paginated where the scenario catalogue is not, because this list
# grows. The maximum is a server-side ceiling: ?limit=100000 is refused, not served.
SESSION_PAGE_SIZE=20
SESSION_PAGE_MAX=100

# Below this mean per-word ASR probability a turn is flagged, so that m9 keeps it out of
# accuracy trends (PRD §7.5, R2). It is still stored and still answered — the speaker
# said something. **0.60 is a placeholder, not a finding:** nothing has yet measured
# where learner speech sits on this scale. See handoff Q11.
ASR_CONFIDENCE_FLOOR=0.60

# ── Progress ────────────────────────────────────────────────────────────────
#
# These are the sample gates, and they exist to stop a chart drawing a confident line
# through noise. Every one of them is a floor below which a figure is *withheld with a
# reason on screen* rather than hidden — an omitted point reads as a week somebody did
# not practise, which is a different and wrong claim.

# How far back the progress page looks, in days.
PROGRESS_TREND_DAYS=30

# Words in one period before that period gets a point on a fluency or accuracy chart.
# Both are rates per unit of speech, and a rate over eleven words is arithmetic rather
# than measurement.
PROGRESS_MIN_WORDS=50

# Scored readings before any per-sound trend is shown at all, and instances of one sound
# within a period before that sound gets a point. Pronunciation scores move with the
# microphone, the room and the distance from it, so the first few readings describe the
# setup as much as the speaker.
PROGRESS_MIN_ATTEMPTS=5
PROGRESS_MIN_PHONE_SAMPLES=5

# Times a verb form was said or needed before the API gives its accuracy as a
# proportion, and before the grammar page can name it the form to practise. The pages
# show the counts — "right 2 of 3" — and not the proportion.
PROGRESS_MIN_FORM_CONTEXTS=10

# Points on a series before a *direction* is claimed. The points are drawn as soon as
# they exist; "improving" over two of them is a line through noise, and it is the
# sentence a learner would act on.
PROGRESS_MIN_POINTS=3

# How far back the pronunciation baseline reaches, in days. Every phone score is
# expressed as a distance from this speaker's own recent history rather than as a raw
# value, because a raw value compares them against a microphone.
PROGRESS_BASELINE_DAYS=90

# How many things to suggest practising next. Three: long enough to offer a choice,
# short enough that every entry has a measured reason worth reading.
RECOMMEND_LIMIT=3

# Corrections against a verb form before the grammar page names it the one to practise.
# Many of the language model's corrections are wrong, and fewer than five could be the
# detector's mistakes rather than the speaker's.
GRAMMAR_MIN_FORM_CORRECTIONS=5
