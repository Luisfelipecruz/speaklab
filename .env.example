# SpeakLab — copy to .env and edit nothing. Every key here has a working default in
# docker-compose.yml, so a fresh clone starts with `cp .env.example .env && make up`.
#
# Ports are offset from the other stacks on this machine so all of them run at once:
# frontend 3003, api 8002, postgres 5433, asr 8101, tts 8102, pron 8103. See
# speaklab-agent/IMPLEMENTATION-PLAN.md §2.1.

# ── Database ────────────────────────────────────────────────────────────────
DB_USER=speaklab
DB_PASSWORD=speaklab_dev
DB_NAME=speaklab

# SQL_ECHO=1 logs every statement SQLAlchemy emits. Useful for proving a query count
# rather than asserting one.
SQL_ECHO=0

# ── Model services ──────────────────────────────────────────────────────────
#
# Three services, none of them inside the API image (I5). The API has NO depends_on for
# any of them: it must start and serve scenarios, sessions and progress while the models
# are still loading, and on a machine that never starts them at all (FR-27).
#
# asr   m4  faster-whisper on CTranslate2 — no torch. 746 MB measured, not the ~400 MB
#           m4 was planned around; the weight is CTranslate2 plus ONNX Runtime (Silero
#           VAD's runtime). openai-whisper would be ~2.5 GB, which was the actual point.
# tts   m5  Piper on ONNX — ~60 MB per voice
# pron  m8  wav2vec2 + torch, ~2 GB. Profiled separately for that reason.
#
# As of m4, asr is NOT profiled: it is part of the default stack, so `make up` builds it
# and downloads the weights on a first run. The API still has no depends_on for it.
ASR_URL=http://asr:8101
TTS_URL=http://tts:8102
PRON_URL=http://pron:8103

# How long /health waits on each model service before calling it unreachable. The three
# probes run concurrently, so this is the ceiling for all three, not per service. It is
# deliberately short: /health is what the container healthcheck curls, and a liveness
# probe that can hang is worse than no probe.
HEALTH_PROBE_TIMEOUT_S=1.5

PIPER_VOICE=en_US-lessac-medium
PRON_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft

# ── Audio and ASR (m4) ──────────────────────────────────────────────────────
#
# small.en at beam 5 measures 1.72% WER on the golden set and 1231 ms on ~6 s of audio,
# against a 700 ms budget it therefore MISSES. base.en at beam 1 meets the budget at
# 525 ms and costs 4.31% WER. The full measurement and the reason the default did not
# change is docs/decisions/0001-asr-model-choice.md; the switch is one line:
#   WHISPER_MODEL=base.en
#   WHISPER_BEAM_SIZE=1
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

# Silero VAD. On by default because Whisper hallucinates on silence — it writes
# "Thank you." for an empty recording, and a learner who hesitated would be scored on
# words they never said. Measured: turning it off doubled WER *and* was slower.
WHISPER_VAD=1

# 0 lets CTranslate2 choose, which is right on a machine this file cannot know the size
# of. Set it when the container shares a host with something latency-sensitive.
WHISPER_CPU_THREADS=0

# Where recordings live: a named volume, never a bind mount and never a path inside the
# repository. A recording that can appear in `git status` is one that can reach history.
AUDIO_ROOT=/audio

# 10 MB, roughly five minutes of 16 kHz mono WAV and far more of anything a browser
# sends. The asr service enforces a higher ceiling of its own — the API's limit is a
# product decision, the service's is a bound on damage.
MAX_UPLOAD_BYTES=10485760

# Long on purpose, and not HEALTH_PROBE_TIMEOUT_S. A cold asr container is loading
# weights and the first transcription after a restart waits for that; failing early
# would turn a slow start into a lost recording.
ASR_TIMEOUT_S=120

# ── Auth (m3) ───────────────────────────────────────────────────────────────
#
# JWT_SECRET is the one key here with no safe default. Left unset, the API signs
# sessions with a fixed development key that is written down in api/config.py — anyone
# holding this repository can mint a valid session cookie — and it says so in the
# startup log every time. That is the right trade for a laptop and wrong everywhere
# else. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Fixed rather than random-per-process on purpose: a random default would invalidate
# every cookie on restart, and under more than one worker each worker would sign with a
# different key, so a user would be logged out on most of their requests with nothing in
# the logs to explain it.
# JWT_SECRET=

# How long a session lasts. There is no refresh token and no revocation list, so this is
# also how long a stolen cookie stays useful. Seven days.
ACCESS_TOKEN_TTL_HOURS=168

# Set to 1 wherever there is TLS. Left at 0 for the laptop stack, which is http:// —
# a Secure cookie there is set by the API, dropped by the browser, and the only symptom
# is a login that appears to work followed by a /auth/me that 401s.
COOKIE_SECURE=0

# `lax` covers localhost:3003 -> localhost:8002 (SameSite ignores the port, so those are
# the same site) and app.example.com -> api.example.com. Genuinely different domains
# need `none`, which also requires COOKIE_SECURE=1.
COOKIE_SAMESITE=lax

# ── Generation (m6) ─────────────────────────────────────────────────────────
#
# host.docker.internal, deliberately. Docker Desktop on macOS cannot pass the Apple GPU
# into a Linux container, so `docker compose --profile llm up ollama` runs the same model
# on CPU — several times slower for no benefit. The host's Ollama uses Metal. Switch to
# http://ollama:11434 on a Linux host with a GPU, or in CI.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# gemma3:4b is already pulled on this machine, so m6 needs no download. Whether 4b is
# strong enough for constrained-JSON error labelling is open question Q4, answered at m9
# by the out-of-taxonomy rejection rate — not by preference.
OLLAMA_MODEL=gemma3:4b

# Ceilings, not targets. A prompt-assembly bug shows up here as a refused request
# rather than as a five-minute turn.
LLM_TIMEOUT_S=120
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=400
