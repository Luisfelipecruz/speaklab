# Everything the build downloads, at exact versions, each with the SHA-256 (or, for npm's
# tarball, the SHA-512) its publisher lists. scripts/fetch.sh checks every file against
# both: the checksum file published beside it, and the value written here.

# CPython, python-build-standalone's stripped install-only build. The patch is the one the
# images run.
PBS_TAG=20261013
PYTHON_VERSION=3.12.15
PYTHON_FILE="cpython-${PYTHON_VERSION}+${PBS_TAG}-aarch64-apple-darwin-install_only_stripped.tar.gz"
PYTHON_SHA256=9866e11cf2ae9caa1e671383786f248859a52dd8bfb702fb4c0dc2c65f1d36de

# uv installs the four environments; the host's own is not used. Nothing published after
# the requirements files last changed is considered, so every build resolves the same
# transitive versions, and a release hours old cannot reach the app. A pin newer than this
# fails the build, and the cutoff moves with it.
UV_EXCLUDE_NEWER=2026-10-24T22:16:29Z
UV_VERSION=0.13.1
UV_FILE=uv-aarch64-apple-darwin.tar.gz
UV_SHA256=cfe454573412ff7380d15fc7dae5997ab53ffce72fce0a78e91ddbc84001acd2

# Node builds the frontend and runs the desktop package's tools. The images' version, and
# the one Electron's own Node reports.
NODE_VERSION=24.22.0
NODE_FILE="node-v${NODE_VERSION}-darwin-arm64.tar.gz"
NODE_SHA256=6a9724d9b50a5f22b4816cded441b5a8d9ddae546191a5e5b7efa5a5e2ee26d5

# pnpm at the version both package.json files name: the platform executable that the
# `pnpm` package installs, taken directly, so no install script runs. The SHA-512 is the
# registry's integrity value, in hex.
PNPM_VERSION=12.4.1
PNPM_FILE="exe.darwin-arm64-${PNPM_VERSION}.tgz"
PNPM_SHA512=eab919913de219f6b192751d187adaa92585bd36ba3746a300796ebfd031d06456b34b087063621610e8a6feb14990ac259986e3cdda352fdbe94103cb76e57f

# PostgreSQL 16 from theseus-rs: thin arm64, every client tool, no ICU.
PG_VERSION=16.15.0
PG_FILE="postgresql-${PG_VERSION}-aarch64-apple-darwin.tar.gz"
PG_SHA256=46f6382024d9b633d1f4b4903ffef8c2404e00ae83098d628c00591048cb0512

# The voice the tts image downloads, by commit of rhasspy/piper-voices.
VOICE=en_US-lessac-medium
VOICE_REVISION=5041a7a49ae5b3a0f30e6837769eb03fdbb231bd
VOICE_PATH=en/en_US/lessac/medium
VOICE_ONNX_SHA256=5efe09e69902187827af646e1a6e9d269dee769f9877d17b16b1b46eeaaf019f
VOICE_JSON_SHA256=efe19c417bed055f2d69908248c6ba650fa135bc868b0e6abb3da181dab690a0

# The two NLTK corpora g2p_en reads, as the pron image downloads them, by commit of
# nltk/nltk_data.
NLTK_REVISION=550b6625bcef1f2abff2ff770a5a0d272c9c6b2a
NLTK_CMUDICT_SHA256=d07cca47fd72ad32ea9d8ad1219f85301eeaf4568f8b6b73747506a71fb5afd6
NLTK_TAGGER_SHA256=6025f530624335c67d6547d44757b357b4e79bae030a0383e9887a92c1718f0b
