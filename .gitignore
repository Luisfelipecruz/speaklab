# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.ruff_cache/

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# The walkthrough recorder, and the takes, voices and soundtracks it makes. It films the
# product rather than being part of it, and it stays on the machine that records.
demo/

# Environment
.env
.env.local

# Audio + models — never commit these
#
# The golden evaluation fixtures (eval/golden/) are the one exception and need
# `git add -f`. They are human recordings, they are small, and they are the only
# audio in the repository.
audio_data/

# Anchored with a leading slash, and that slash is load-bearing. An unanchored
# `models/` matches a directory called `models` at EVERY level, and would silently
# exclude `api/models/` — the Pydantic layer — from `git add`. The pattern is
# meant for a top-level cache of downloaded weights; the extension patterns below are
# what catch weight files wherever they land.
/models/
*.wav
*.webm
*.mp3
*.onnx
*.bin
*.pt

# The pronunciation pairs as they come off a recorder, before conversion to .wav — a
# person's voice in whatever format the recorder wrote, so no extension pattern above
# would catch it.
eval/golden/pron/raw/

# The feasibility spike is throwaway; its findings are in docs/decisions/
spike/

# Working notes, never tracked: they describe how the work is produced, not what was
# produced. PR bodies for `gh pr create --body-file`; speaklab-agent/, the build plan, the
# session notes and the command sheet; and CLAUDE.md, which binds agents working in this
# checkout and means nothing to a reader of the repository. PRD.md is the product
# specification and is tracked.
.pr-bodies/
CLAUDE.md
/speaklab-agent/

# The project site as `make site` builds it. The Pages workflow builds its own from main.
/_site/

# Editors
.idea/
.vscode/
*.swp

# macOS
.DS_Store

# The half of the error golden set that cannot be published. It is real recorded speech
# about somebody's real work; the role-play half ships in labels.json and manifest.json.
# eval/golden/errors/build.py writes the .local files from the database when the labels
# are there, and the measurement suite prefers them and says which set it used.
eval/golden/errors/labels.local.json
eval/golden/errors/manifest.local.json

# What a `make eval` run produced, before eval/report.py turns it into
# docs/evaluation.md. Raw per-suite JSON, rewritten from scratch on every run and
# meaningless without the date it was taken on. The report is the artefact; this is the
# scratch space it is rendered from.
.eval/
