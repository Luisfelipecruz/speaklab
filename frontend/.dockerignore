# Without this, `COPY . .` ships the host's node_modules into the image and overwrites the
# one pnpm just installed for the container's platform. Native modules built for macOS do
# not run on linux/arm64, and the failure appears at runtime as a missing binary rather
# than at build time as an error.
node_modules
.next
npm-debug.log*
pnpm-debug.log*
.env.local
